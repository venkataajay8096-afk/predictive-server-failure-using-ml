# =========================================================================
# SENTRYML ENVIRONMENT CONFIGURATION TEMPLATE
# Rename this file to '.env' and populate with your database credentials
# =========================================================================

# Flask Secret Key (Change this to a secure random string in production)
SECRET_KEY=predictive-server-failure-detect-key-9821

# MySQL Connection Details
# Un-comment and populate these variables to connect a MySQL Server database.
# If these variables remain empty or commented out, SentryML will automatically
# fallback to a self-contained local SQLite 'project.db' file.

# MYSQL_USER=root
# MYSQL_PASSWORD=your_secure_password
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DB=sentryml_db
